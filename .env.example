# ====================================================
# Pipeline Sentinel - Environment Variables (Example)
# ====================================================

# JWT_SECRET: minimum 32 characters (used to sign tokens)
JWT_SECRET=test-jwt-secret-not-for-production-32chars!!

# PIPELINE_API_KEY: API key for authentication (any value except "disabled")
PIPELINE_API_KEY=test-api-key-not-for-production-32chars!!