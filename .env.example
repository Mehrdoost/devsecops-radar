# ----------------------------------------------------------------------
# Pipeline Sentinel – Environment Configuration Template
# ----------------------------------------------------------------------
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control!
#
# Generating strong random values:
#   python -c "import secrets; print(secrets.token_hex(32))"   → 64‑character hex
#   python -c "import secrets; print(secrets.token_urlsafe(30))" → 40‑character URL‑safe
# ----------------------------------------------------------------------

# ---- Required Settings -------------------------------------------------

# The password used to access the Pipeline Sentinel dashboard.
# Must be at least 20 characters long.
PIPELINE_API_KEY=your-api-key-here

# The secret used to sign JWT authentication tokens.
# Must be at least 64 characters (32 bytes hex). Use the command above to generate one.
JWT_SECRET=your-jwt-secret-here

# ---- Optional Settings -------------------------------------------------

# Database URL (default: SQLite in ~/.devsecops-radar/pipeline_sentinel.db)
# DATABASE_URL=sqlite:///C:/path/to/pipeline_sentinel.db

# If set, the SQLite database will be encrypted using sqlcipher3.
# Requires: pip install pysqlcipher3
# Generate a strong key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# DB_ENCRYPTION_KEY=your-encryption-key-here

# OLLAMA_API_BASE=http://localhost:11434/api/generate

# Community rules repository (must be https://github.com/...)
# COMMUNITY_RULES_REPO=https://github.com/your-org/devsecops-radar-rules.git

# Jira integration (requires JIRA_URL and JIRA_TOKEN)
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_TOKEN=your-jira-api-token
# JIRA_PROJECT_KEY=SEC
# JIRA_ISSUE_TYPE=Bug

# Asana integration (requires ASANA_TOKEN and ASANA_WORKSPACE)
# ASANA_TOKEN=your-asana-token
# ASANA_WORKSPACE=1234567890

# Webhook secret for sentry feed (optional HMAC signature verification)
# WEBHOOK_SECRET=your-webhook-secret